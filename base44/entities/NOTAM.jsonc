{
  "name": "NOTAM",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "NOTAM title"
    },
    "content": {
      "type": "string",
      "description": "Full NOTAM text"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "expires": {
      "type": "string",
      "format": "date",
      "description": "Expiry date (leave blank for permanent)"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}