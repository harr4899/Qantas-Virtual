{
  "name": "HomeStats",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Stat label e.g. Total Flights"
    },
    "value": {
      "type": "string",
      "description": "Stat value e.g. 1,200+"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide (Plane, Users, Globe, etc.)",
      "default": "Globe"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "label",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}