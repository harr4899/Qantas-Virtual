{
  "name": "EventSignup",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "name": { "type": "string" },
    "email": { "type": "string" },
    "pilot_email": { "type": "string", "description": "Set if registered pilot" },
    "role": { "type": "string", "enum": ["pilot", "passenger"], "default": "passenger" },
